<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<title>SPHEREx Sky Watcher · NASA × SpaceX Challenge 2026</title>
<style>
  :root {
    --bg: #02040a;
    --panel: #0a1020;
    --panel-2: #0e1630;
    --border: #1a2542;
    --border-2: #2a3a63;
    --text: #eef3ff;
    --sub: #8ea0c8;
    --dim: #5a6b8c;
    --accent: #5b9dff;
    --accent-2: #7fb3ff;
    --pink: #ff5e8a;
    --amber: #ffb347;
    --red: #ff7864;
    --gold: #ffd47a;
    --violet: #b57bff;
    --green: #37e0a0;
    --mono: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    background: radial-gradient(ellipse 90% 60% at 50% -10%, #0c1630 0%, transparent 55%), var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.55;
    min-height: 100vh;
    padding: 16px;
    overflow-x: hidden;
  }
  .wrap { max-width: 1500px; margin: 0 auto; }

  /* ---------- Cinematic intro ---------- */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: radial-gradient(circle at center, #0a1428 0%, #02040a 70%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    transition: opacity 1s ease;
  }
  .intro.fade { opacity: 0; pointer-events: none; }
  .intro-logo {
    width: 80px; height: 80px;
    border-radius: 20px;
    background: radial-gradient(circle at 30% 25%, #7fb3ff, #1e3a7a 60%, #0a1428);
    box-shadow: 0 0 50px rgba(91,157,255,0.5);
    display: grid;
    place-items: center;
    font-size: 2.5rem;
    animation: introPulse 2s ease-in-out infinite;
  }
  @keyframes introPulse { 50% { transform: scale(1.08); box-shadow: 0 0 70px rgba(91,157,255,0.8); } }
  .intro-title {
    font-size: 1.8rem;
    font-weight: 700;
    background: linear-gradient(135deg, #fff, #7fb3ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.01em;
  }
  .intro-sub {
    color: var(--sub);
    font-size: 0.9rem;
    font-family: var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .intro-progress {
    width: 220px;
    height: 3px;
    background: rgba(91,157,255,0.15);
    border-radius: 3px;
    overflow: hidden;
  }
  .intro-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    animation: introLoad 2.4s ease-out forwards;
  }
  @keyframes introLoad {
    from { width: 0%; }
    to { width: 100%; }
  }

  /* ---------- Header ---------- */
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: 1.35rem;
    font-weight: 700;
    background: linear-gradient(135deg, #fff, #7fb3ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .sub { color: var(--sub); font-size: 0.78rem; margin-top: 2px; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .badge {
    background: var(--panel);
    border: 1px solid var(--border);
    color: var(--sub);
    padding: 4px 11px;
    border-radius: 40px;
    font-size: 0.7rem;
  }
  .badge strong { color: var(--accent); }
  .badge.spacex { border-color: rgba(255,255,255,0.2); }

  /* ---------- Controls ---------- */
  .controls {
    background: linear-gradient(180deg, var(--panel), var(--panel-2));
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 12px 16px;
    margin-bottom: 12px;
  }
  .ctrl-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ctrl-row + .ctrl-row { margin-top: 10px; }
  .ctrl-label {
    font-size: 0.66rem;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 600;
    flex-shrink: 0;
  }
  .btn {
    background: #141c34;
    border: 1px solid var(--border-2);
    color: var(--text);
    padding: 7px 13px;
    border-radius: 9px;
    font-size: 0.8rem;
    font-family: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .btn:hover { background: #1e2a4a; border-color: var(--accent); }
  .btn.on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    box-shadow: 0 0 12px rgba(91,157,255,0.4);
  }
  .btn.primary {
    background: linear-gradient(135deg, var(--accent), var(--violet));
    border: none;
    color: #fff;
    box-shadow: 0 4px 16px rgba(91,157,255,0.4);
  }
  .btn.primary:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(91,157,255,0.6); }

  /* Speed control */
  .speed-group {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 4px 10px 4px 12px;
  }
  .speed-presets {
    display: flex;
    gap: 3px;
    background: rgba(0,0,0,0.35);
    border-radius: 8px;
    padding: 3px;
  }
  .speed-preset {
    background: transparent;
    border: none;
    color: var(--sub);
    padding: 4px 9px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-family: var(--mono);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    min-width: 40px;
    text-align: center;
  }
  .speed-preset:hover { color: var(--text); background: rgba(255,255,255,0.05); }
  .speed-preset.on {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 8px rgba(91,157,255,0.4);
  }
  .speed-fine {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 6px;
    border-left: 1px solid var(--border);
  }
  .speed-fine input[type=range] {
    width: 100px;
    height: 4px;
    min-width: 100px;
    flex: none;
  }
  .speed-value {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: rgba(0,0,0,0.4);
    padding: 3px 8px;
    border-radius: 6px;
    min-width: 52px;
    text-align: center;
  }

  .timeline-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 280px;
  }
  input[type=range] {
    -webkit-appearance: none;
    flex: 1;
    min-width: 140px;
    height: 5px;
    background: #0a1226;
    border-radius: 4px;
    outline: none;
    cursor: pointer;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--accent);
    box-shadow: 0 0 12px rgba(91,157,255,0.5);
    cursor: grab;
  }
  input[type=range]::-moz-range-thumb {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--accent);
    box-shadow: 0 0 12px rgba(91,157,255,0.5);
    cursor: grab;
  }
  .readout {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    background: rgba(0,0,0,0.5);
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid var(--border);
    min-width: 90px;
    text-align: center;
  }

  /* Band selector */
  .band-selector {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    align-items: center;
  }
  .band-chip {
    background: #141c34;
    border: 1px solid var(--border-2);
    color: var(--sub);
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 0.68rem;
    font-family: var(--mono);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .band-chip:hover { border-color: var(--accent); color: var(--text); }
  .band-chip.on {
    color: #fff;
    border-color: currentColor;
    box-shadow: 0 0 10px currentColor;
  }
  .band-chip .wl {
    display: block;
    font-size: 0.55rem;
    font-weight: 400;
    opacity: 0.7;
    margin-top: 1px;
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  @media (max-width: 950px) { .grid { grid-template-columns: 1fr; } }

  .card {
    background: linear-gradient(180deg, #0a1224, #060c1a);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px -20px rgba(0,0,0,0.9);
  }
  .card.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 20px 40px -20px rgba(0,0,0,0.9);
  }
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 14px;
    background: linear-gradient(180deg, rgba(255,255,255,0.025), transparent);
    border-bottom: 1px solid var(--border);
  }
  .card-title {
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pip {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .pip.pip-1 { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
  .epoch-tag {
    font-family: var(--mono);
    font-size: 0.66rem;
    font-weight: 600;
    color: var(--sub);
    background: rgba(0,0,0,0.35);
    padding: 3px 9px;
    border-radius: 20px;
    border: 1px solid var(--border);
  }
  .canvas-wrap {
    position: relative;
    background: #000;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .canvas-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 48%, rgba(0,0,0,0.7) 100%);
    z-index: 3;
  }
  canvas { display: block; width: 100%; height: 100%; }

  .overlay {
    position: absolute;
    z-index: 5;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 0.66rem;
    color: #fff;
    letter-spacing: 0.04em;
  }
  .motion-badge {
    top: 10px; right: 10px;
    padding: 5px 10px;
    border-radius: 8px;
    font-weight: 700;
    letter-spacing: 0.12em;
    background: linear-gradient(90deg, var(--pink), #ff8fb1);
    box-shadow: 0 0 14px rgba(255,94,138,0.55);
    animation: motionPulse 1.8s ease-in-out infinite;
  }
  @keyframes motionPulse { 50% { opacity: 0.6; transform: scale(0.97); } }
  .band-badge {
    bottom: 10px; left: 10px;
    padding: 5px 10px;
    border-radius: 7px;
    background: rgba(0,0,0,0.75);
    border: 1px solid currentColor;
    backdrop-filter: blur(6px);
    font-weight: 700;
    letter-spacing: 0.08em;
    transition: all 0.3s;
  }
  .speed-badge {
    bottom: 10px; right: 10px;
    padding: 5px 10px;
    border-radius: 7px;
    background: rgba(0,0,0,0.75);
    border: 1px solid var(--accent);
    backdrop-filter: blur(6px);
    font-weight: 700;
    color: var(--accent-2);
    letter-spacing: 0.08em;
    transition: all 0.2s;
  }
  .blink-indicator {
    top: 10px; left: 10px;
    padding: 5px 10px;
    border-radius: 7px;
    background: rgba(0,0,0,0.75);
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(6px);
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .blink-indicator.on { opacity: 1; }

  /* Bottom panels */
  .bottom {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 14px;
    margin-top: 14px;
  }
  @media (max-width: 1100px) { .bottom { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 700px) { .bottom { grid-template-columns: 1fr; } }

  .panel {
    background: linear-gradient(180deg, var(--panel), var(--panel-2));
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 18px;
  }
  .panel h3 {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .panel h3 .sub-h {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--sub);
    font-size: 0.68rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .stat {
    background: rgba(0,0,0,0.28);
    border-radius: 9px;
    padding: 8px 11px;
    border: 1px solid rgba(255,255,255,0.03);
  }
  .stat-label {
    font-size: 0.6rem;
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
  }
  .stat-value {
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }
  .stat-value.accent { color: var(--accent); }
  .stat-value.pink { color: var(--pink); }
  .stat-value.gold { color: var(--gold); }

  .legend {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 0.7rem;
    color: var(--sub);
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .legend-item { display: flex; align-items: center; gap: 6px; }
  .sw {
    width: 10px; height: 10px;
    border-radius: 50%;
  }
  .sw-star { background: #fff; box-shadow: 0 0 5px #fff; }
  .sw-comet { background: #7fb3ff; box-shadow: 0 0 6px #7fb3ff; }
  .sw-asteroid { background: var(--amber); box-shadow: 0 0 5px var(--amber); }
  .sw-fast { background: var(--red); box-shadow: 0 0 5px var(--red); }
  .sw-nebula { background: var(--gold); box-shadow: 0 0 8px var(--gold); }

  .star-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 340px;
    overflow-y: auto;
    padding-right: 6px;
  }
  .star-list::-webkit-scrollbar { width: 4px; }
  .star-list::-webkit-scrollbar-track { background: transparent; }
  .star-list::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 4px; }
  .star-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 9px;
    border-radius: 7px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: background 0.15s;
    border: 1px solid transparent;
  }
  .star-row:hover { background: rgba(91,157,255,0.08); }
  .star-row.selected {
    background: rgba(91,157,255,0.14);
    border-color: rgba(91,157,255,0.4);
  }
  .star-row .dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px currentColor;
  }
  .star-row .nm { flex: 1; color: var(--text); font-weight: 500; }
  .star-row .bayer {
    font-family: var(--mono);
    font-size: 0.6rem;
    color: var(--dim);
  }
  .star-row .cls {
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--sub);
    background: rgba(0,0,0,0.3);
    padding: 1px 6px;
    border-radius: 4px;
  }
  .star-row .mag {
    font-family: var(--mono);
    font-size: 0.66rem;
    color: var(--dim);
  }
  .star-row .dist {
    font-family: var(--mono);
    font-size: 0.62rem;
    color: var(--dim);
  }

  .info-panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .info-hint {
    color: var(--dim);
    font-style: italic;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .info-header {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .info-id {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    background: rgba(0,0,0,0.4);
    padding: 3px 9px;
    border-radius: 7px;
    border: 1px solid var(--border);
    letter-spacing: 0.06em;
  }
  .info-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
  }
  .info-bayer {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--dim);
  }
  .info-fields {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--sub);
    margin-top: 4px;
  }
  .info-fields span strong { color: var(--text); font-weight: 600; }
  .info-desc {
    font-size: 0.8rem;
    color: var(--sub);
    line-height: 1.55;
    border-left: 2px solid var(--accent);
    padding-left: 10px;
    margin-top: 6px;
  }
  .info-desc strong { color: var(--text); }
  .spectrum-bar {
    display: flex;
    height: 26px;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border);
    margin-top: 6px;
  }
  .spectrum-bar .band {
    flex: 1;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.55rem;
    color: rgba(255,255,255,0.75);
    font-weight: 600;
    position: relative;
  }
  .spectrum-bar .band.on {
    color: #fff;
    box-shadow: inset 0 0 0 2px #fff;
  }

  /* Presentation mode */
  body.presenting header,
  body.presenting .controls,
  body.presenting .bottom,
  body.presenting footer {
    display: none;
  }
  body.presenting .grid {
    grid-template-columns: 1fr;
    max-width: 100vh;
    margin: 0 auto;
  }
  body.presenting .card:first-child {
    display: none;
  }
  body.presenting .card.active {
    border-color: var(--border);
    box-shadow: 0 20px 40px -20px rgba(0,0,0,0.9);
  }
  .presentation-exit {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 100;
    background: rgba(0,0,0,0.8);
    border: 1px solid var(--border-2);
    color: var(--text);
    padding: 8px 16px;
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 0.8rem;
    cursor: pointer;
    display: none;
  }
  body.presenting .presentation-exit { display: block; }

  footer {
    margin-top: 20px;
    text-align: center;
    font-size: 0.72rem;
    color: var(--dim);
    border-top: 1px solid var(--border);
    padding-top: 16px;
    line-height: 1.6;
  }
  footer kbd {
    font-family: var(--mono);
    font-size: 0.68rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--border);
    padding: 1px 5px;
    border-radius: 4px;
    color: var(--sub);
  }

  @media (max-width: 700px) {
    body { padding: 12px; }
    .controls { padding: 10px; }
    .btn { padding: 6px 10px; font-size: 0.75rem; }
    h1 { font-size: 1.15rem; }
    .speed-preset { min-width: 34px; padding: 3px 6px; font-size: 0.66rem; }
    .speed-fine input[type=range] { width: 70px; min-width: 70px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
</head>
<body>

<!-- Cinematic intro -->
<div class="intro" id="intro">
  <div class="intro-logo">🔭</div>
  <div class="intro-title">SPHEREx Sky Watcher</div>
  <div class="intro-sub">NASA × SpaceX Challenge 2026</div>
  <div class="intro-progress"><div class="intro-progress-bar"></div></div>
</div>

<button class="presentation-exit" id="presentationExit">✕ Exit presentation</button>

<div class="wrap">

  <header>
    <div>
      <h1>SPHEREx Sky Watcher</h1>
      <div class="sub">Real Orion field · 102-band explorer · NASA × SpaceX Challenge 2026</div>
    </div>
    <div class="badges">
      <span class="badge"><strong>102</strong> bands</span>
      <span class="badge">30° field · M42</span>
      <span class="badge spacex">🛰️ Challenge 2026</span>
    </div>
  </header>

  <div class="controls">
