</div>

<script>
(function () {
  'use strict';

  const W = 700, H = 700;

  /* -------- PRNG -------- */
  let seed = 0xCAFE;
  function rand() {
    seed = (seed * 16807) % 2147483647;
    return (seed - 1) / 2147483646;
  }
  function gaussian() {
    const u1 = Math.max(rand(), 1e-6), u2 = rand();
    return Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2);
  }
  function rr(a, b) { return a + rand() * (b - a); }

  /* -------- Spectral classes -------- */
  const SPECTRAL = {
    O: { color: '#a8c8ff', temp: '30,000+ K' },
    B: { color: '#b8d4ff', temp: '10,000–30,000 K' },
    A: { color: '#e8f0ff', temp: '7,500–10,000 K' },
    F: { color: '#fff5e8', temp: '6,000–7,500 K' },
    G: { color: '#ffe9b0', temp: '5,200–6,000 K' },
    K: { color: '#ffc888', temp: '3,700–5,200 K' },
    M: { color: '#ff9a78', temp: 'Under 3,700 K' },
  };

  /* -------- 12 SPHEREx wavelength slices -------- */
  const BANDS = [
    { id: 1, wl: 0.75, name: 'D1a', color: '#9ab8ff', desc: 'Visible-red edge. Hot O/B stars dominate.', filter: (o) => o.type === 'star' && (o.spectral === 'O' || o.spectral === 'B' || o.spectral === 'A') },
    { id: 2, wl: 0.95, name: 'D1b', color: '#9db0ff', desc: 'Blue-violet to near-IR boundary.', filter: (o) => o.type === 'star' && o.spectral !== 'M' },
    { id: 3, wl: 1.10, name: 'D2a', color: '#8ea0ff', desc: 'Near-infrared. F/G/K stars peak here.', filter: (o) => o.type === 'star' && (o.spectral === 'F' || o.spectral === 'G' || o.spectral === 'K') },
    { id: 4, wl: 1.40, name: 'D2b', color: '#a090ff', desc: 'Water vapor absorption begins.', filter: (o) => o.type === 'star' || o.type === 'nebula' },
    { id: 5, wl: 1.60, name: 'D3a', color: '#b98aff', desc: 'Deep NIR. Red giants dominate.', filter: (o) => (o.type === 'star' && o.spectral === 'M') || o.type === 'nebula' },
    { id: 6, wl: 1.90, name: 'D3b', color: '#c68aff', desc: 'Dust-penetrating. Reveals embedded stars.', filter: (o) => o.type === 'nebula' || o.type === 'comet' },
    { id: 7, wl: 2.20, name: 'D4a', color: '#d47aff', desc: 'PAH emission peaks here.', filter: (o) => o.type === 'nebula' || o.type === 'comet' },
    { id: 8, wl: 2.60, name: 'D4b', color: '#e07aff', desc: 'PAH + water ice features.', filter: (o) => o.type === 'nebula' || o.type === 'comet' },
    { id: 9, wl: 3.10, name: 'D5a', color: '#ff7bd4', desc: 'Water ice absorption.', filter: (o) => o.type === 'nebula' || o.type === 'comet' },
    { id: 10, wl: 3.50, name: 'D5b', color: '#ff8fc8', desc: 'CO₂ ice + PAH.', filter: (o) => o.type === 'nebula' || o.type === 'comet' },
    { id: 11, wl: 4.20, name: 'D6a', color: '#ff8fb1', desc: 'Cold dust emission.', filter: (o) => o.type === 'nebula' || o.type === 'fast' || o.type === 'asteroid' || o.type === 'comet' },
    { id: 12, wl: 4.60, name: 'D6b', color: '#ff9a9a', desc: 'Deepest band. Cold dust + distant galaxies.', filter: (o) => o.type !== 'star' || o.type === 'star' },
  ];

  let currentBand = 0;

  /* -------- Deep-sky objects -------- */
  const nebulae = [
    { id: 'M42', name: 'Orion Nebula', x: 350, y: 380, size: 120, hue: 210, intensity: 0.07 },
    { id: 'M43', name: "De Mairan's Nebula", x: 330, y: 400, size: 45, hue: 200, intensity: 0.05 },
    { id: 'NGC1977', name: 'Running Man Nebula', x: 400, y: 280, size: 60, hue: 220, intensity: 0.045 },
    { id: 'Barnard', name: "Barnard's Loop", x: 240, y: 500, size: 130, hue: 190, intensity: 0.035 },
    { id: 'NGC1980', name: 'Lower Sword', x: 320, y: 420, size: 50, hue: 215, intensity: 0.03 },
    { id: 'NGC2024', name: 'Flame Nebula', x: 305, y: 490, size: 55, hue: 20, intensity: 0.04 },
    { id: 'B33', name: 'Horsehead Nebula', x: 290, y: 505, size: 35, hue: 0, intensity: 0.06 },
    { id: 'NGC2169', name: '37 Cluster', x: 410, y: 350, size: 40, hue: 220, intensity: 0.03 },
    { id: 'NGC2194', name: 'Collinder 72', x: 430, y: 320, size: 45, hue: 210, intensity: 0.025 },
    { id: 'LDN1640', name: 'L1630 Dark Cloud', x: 310, y: 480, size: 70, hue: 250, intensity: 0.02 },
    { id: 'NGC1999', name: 'Reflection Nebula', x: 380, y: 410, size: 30, hue: 195, intensity: 0.035 },
    { id: 'M78', name: 'M78 Reflection Nebula', x: 250, y: 220, size: 40, hue: 225, intensity: 0.03 },
  ];

  const clusters = [
    { x: 350, y: 380, sigma: 55 },
    { x: 280, y: 240, sigma: 60 },
    { x: 480, y: 500, sigma: 70 },
    { x: 350, y: 500, sigma: 40 },
  ];

  /* -------- Objects -------- */
  const objects = [];

  for (const n of nebulae) {
    objects.push({
      id: n.id, name: n.name, type: 'nebula',
      x: n.x, y: n.y, vx: 0, vy: 0,
      size: n.size * 0.4, mag: 4.0, spectral: null, isDSO: true,
      dist: n.id === 'M42' ? '1,344 ly' : '~1,300 ly',
      desc: `<strong>${n.name}.</strong> Part of the Orion molecular cloud complex, one of the nearest and most studied star-forming regions.`
    });
  }

  for (let i = 0; i < 240; i++) {
    let x, y;
    if (rand() < 0.65) {
      const c = clusters[Math.floor(rand() * clusters.length)];
      x = c.x + gaussian() * c.sigma * 0.5;
      y = c.y + gaussian() * c.sigma * 0.5;
    } else {
      x = rr(20, W - 20);
      y = rr(20, H - 20);
    }
    x = Math.max(15, Math.min(W - 15, x));
    y = Math.max(15, Math.min(H - 15, y));
    const mag = rr(7, 17);
    const cls = ['O','B','A','F','G','K','M'][Math.floor(Math.pow(rand(), 1.5) * 7)];
    objects.push({
      id: 'S' + String(i).padStart(3, '0'),
      name: null, type: 'star',
      x, y, vx: 0, vy: 0,
      size: 0.7 + Math.max(0, (16 - mag)) * 0.16,
      mag, spectral: cls,
      dist: '—',
      desc: `<strong>Field star.</strong> Simulated ${cls}-type star in the Orion field.`
    });
  }

  /* -------- Real Orion bright stars -------- */
  const brightStars = [
    { name: 'Betelgeuse', bayer: 'α Orionis', x: 260, y: 180, mag: 0.5, cls: 'M', dist: '~640 ly',
      desc: '<strong>Red supergiant.</strong> Semiregular variable. If placed at the Sun\'s position, its surface would extend past Mars. Will go supernova within ~100,000 years.' },
    { name: 'Rigel', bayer: 'β Orionis', x: 480, y: 540, mag: 0.13, cls: 'B', dist: '~860 ly',
      desc: '<strong>Blue supergiant.</strong> Brightest star in Orion and 6th brightest in the night sky. Triple star system. Name from Arabic <em>rijl</em>, "foot".' },
    { name: 'Bellatrix', bayer: 'γ Orionis', x: 450, y: 170, mag: 1.64, cls: 'B', dist: '~250 ly',
      desc: '<strong>Blue-white giant.</strong> The "Amazon Star". 27th brightest in the night sky. Faintly variable.' },
    { name: 'Mintaka', bayer: 'δ Orionis', x: 380, y: 400, mag: 2.25, cls: 'O', dist: '~1,200 ly',
      desc: '<strong>Multiple star system.</strong> Western star of Orion\'s Belt. Name means "the belt" in Arabic.' },
    { name: 'Alnilam', bayer: 'ε Orionis', x: 350, y: 430, mag: 1.69, cls: 'O', dist: '~2,000 ly',
      desc: '<strong>Blue supergiant.</strong> Middle and brightest star of Orion\'s Belt. Name means "string of pearls". One of the most luminous stars known.' },
    { name: 'Alnitak', bayer: 'ζ Orionis', x: 320, y: 460, mag: 1.74, cls: 'O', dist: '~1,260 ly',
      desc: '<strong>Hot blue supergiant.</strong> Eastern star of Orion\'s Belt. Triple system. Name means "the girdle". The Flame and Horsehead Nebulae lie nearby.' },
    { name: 'Saiph', bayer: 'κ Orionis', x: 250, y: 550, mag: 2.07, cls: 'B', dist: '~650 ly',
      desc: '<strong>Blue supergiant.</strong> Orion\'s left foot. Name means "sword of the giant". Much of its light is emitted in ultraviolet.' },
    { name: 'Meissa', bayer: 'λ Orionis', x: 350, y: 120, mag: 3.33, cls: 'O', dist: '~1,100 ly',
      desc: '<strong>Multiple star marking Orion\'s head.</strong> Name means "the shining one". Part of young cluster Collinder 69.' },
    { name: 'Trapezium C', bayer: 'θ¹ Ori C', x: 348, y: 378, mag: 5.13, cls: 'O', dist: '~1,344 ly',
      desc: '<strong>Brightest star of the Trapezium Cluster</strong> at the heart of the Orion Nebula. ~40 solar masses. Its UV radiation makes the whole nebula glow.' },
  ];

  for (const b of brightStars) {
    objects.push({
      id: b.name, name: b.name, bayer: b.bayer, type: 'star',
      x: b.x, y: b.y, vx: 0, vy: 0,
      size: 2.5 + Math.max(0, (3 - b.mag)) * 0.7,
      mag: b.mag, spectral: b.cls,
      isNamed: true, dist: b.dist,
      desc: b.desc,
    });
  }

  /* -------- Comets with curved Keplerian-like paths -------- */
  for (let i = 0; i < 6; i++) {
    const x = rr(100, W - 100);
    const y = rr(100, H - 100);
    const ang = rand() * Math.PI * 2;
    const spd = rr(120, 200);
    const curve = rr(-60, 60);
    objects.push({
      id: 'C/2025 ' + String.fromCharCode(65 + i) + (i + 1),
      name: null, type: 'comet',
      x, y,
      vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd,
      perpX: Math.cos(ang + Math.PI/2) * curve * 2,
      perpY: Math.sin(ang + Math.PI/2) * curve * 2,
      size: rr(3.5, 6), mag: rr(9, 14),
      dist: '—',
      desc: '<strong>Simulated comet.</strong> Comets develop tails when solar radiation and solar wind push gas and dust away from the Sun.'
    });
  }

  /* -------- Asteroid belt (denser along ecliptic) -------- */
  for (let i = 0; i < 40; i++) {
    const l1 = 'ABCDEFGHJKLMNOP'[Math.floor(rand() * 16)];
    const l2 = 'ABCDEFGHJKLMNOP'[Math.floor(rand() * 16)];
    const x = rr(80, W - 80);
    // Bias toward horizontal band (ecliptic plane)
    const yBias = rr(-1, 1);
    const y = H / 2 + yBias * H * 0.35 + rr(-30, 30);
    objects.push({
      id: `2025 ${l1}${l2}${i + 1}`,
      name: null, type: 'asteroid',
      x, y: Math.max(60, Math.min(H - 60, y)),
      vx: (rand() - 0.5) * 110, vy: (rand() - 0.5) * 110,
      size: rr(2, 3.5), mag: rr(12, 16),
      dist: '~2 AU',
      desc: '<strong>Simulated asteroid.</strong> Main-belt asteroids drift by a few arcminutes over six months. SPHEREx detects them by comparing positions between epochs.'
    });
  }

  /* -------- NEOs -------- */
  for (let i = 0; i < 4; i++) {
    const ang = rand() * Math.PI * 2;
    const spd = rr(180, 260);
    objects.push({
      id: `2025 NEO-${i + 1}`,
      name: null, type: 'fast',
      x: rr(120, W - 120), y: rr(120, H - 120),
      vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd,
      size: rr(3.5, 5.5), mag: rr(13, 16),
      dist: '—',
      desc: '<strong>Simulated near-Earth object.</strong> NEOs move fast because they pass close to Earth. Real surveys like SPHEREx help catalog them for planetary defense.'
    });
  }

  /* -------- Position -------- */
  function posAt(o, t) {
    let x = o.x + o.vx * t;
    let y = o.y + o.vy * t;
    if (o.perpX !== undefined) {
      const k = Math.sin(t * Math.PI);
      x += o.perpX * k;
      y += o.perpY * k;
    }
    return { x, y };
  }

  /* -------- Canvas -------- */
  const cvA = document.getElementById('cvA');
  const cvB = document.getElementById('cvB');
  const ctxA = cvA.getContext('2d');
  const ctxB = cvB.getContext('2d');

  /* -------- Sprite cache -------- */
  const spriteCache = new Map();
  function getStarSprite(radius, colorStr) {
    const key = radius.toFixed(2) + '|' + colorStr;
    if (spriteCache.has(key)) return spriteCache.get(key);
    const size = Math.max(8, Math.ceil(radius * 10));
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const g = c.getContext('2d');
    const cx = size / 2;
    const m = colorStr.match(/(\d+),\s*(\d+),\s*(\d+)/);
    const [r, gg, b] = [m[1], m[2], m[3]];
    const grad = g.createRadialGradient(cx, cx, 0, cx, cx, cx);
    grad.addColorStop(0, `rgba(${r},${gg},${b},1)`);
    grad.addColorStop(0.28, `rgba(${r},${gg},${b},0.75)`);
    grad.addColorStop(0.6, `rgba(${r},${gg},${b},0.18)`);
    grad.addColorStop(1, `rgba(${r},${gg},${b},0)`);
    g.fillStyle = grad;
    g.beginPath(); g.arc(cx, cx, cx, 0, Math.PI * 2); g.fill();
    g.fillStyle = '#fff';
    g.beginPath(); g.arc(cx, cx, radius * 0.5, 0, Math.PI * 2); g.fill();
    const sprite = { canvas: c, size };
    spriteCache.set(key, sprite);
    return sprite;
  }
  function hexToRgbStr(hex) {
    const n = parseInt(hex.slice(1), 16);
    return `rgb(${(n>>16)&255},${(n>>8)&255},${n&255})`;
  }

  /* -------- Background -------- */
  function drawBackground(ctx) {
    const g = ctx.createRadialGradient(W/2, H/2, 40, W/2, H/2, W*0.75);
    const base1 = currentBand < 3 ? '#080d1e' : currentBand < 7 ? '#0a0d24' : '#140a20';
    const base2 = currentBand < 3 ? '#01020a' : currentBand < 7 ? '#01020f' : '#0a0410';
    g.addColorStop(0, base1);
    g.addColorStop(1, base2);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);

    const nebulaIntensity = currentBand >= 6 ? 1.0 : (currentBand >= 3 ? 0.5 : 0.15);
    ctx.globalCompositeOperation = 'lighter';
    for (const n of nebulae) {
      // Parallax: nebula moves slowly with camera (for future pan support)
      const ng = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, n.size);
      ng.addColorStop(0, `hsla(${n.hue}, 70%, 60%, ${n.intensity * nebulaIntensity})`);
      ng.addColorStop(0.5, `hsla(${n.hue}, 70%, 50%, ${n.intensity * nebulaIntensity * 0.4})`);
      ng.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = ng;
      ctx.beginPath(); ctx.arc(n.x, n.y, n.size, 0, Math.PI * 2); ctx.fill();
    }
    ctx.globalCompositeOperation = 'source-over';

    ctx.strokeStyle = 'rgba(60,90,150,0.07)';
    ctx.lineWidth = 1;
    for (let i = 1; i < 10; i++) {
      const p = (i / 10) * W;
      ctx.beginPath(); ctx.moveTo(p, 0); ctx.lineTo(p, H); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, p); ctx.lineTo(W, p); ctx.stroke();
    }
  }

  /* -------- Draw primitives -------- */
  function drawStar(ctx, x, y, size, spectral) {
    const data = SPECTRAL[spectral] || { color: '#ffffff' };
    const rgb = hexToRgbStr(data.color);
    const r = Math.max(0.6, size);
    const sprite = getStarSprite(r, rgb);
    ctx.globalCompositeOperation = 'lighter';
    ctx.drawImage(sprite.canvas, x - sprite.size/2, y - sprite.size/2);
    ctx.globalCompositeOperation = 'source-over';
    if (r > 1.6) {
      const L = r * 6;
      ctx.strokeStyle = 'rgba(190,215,255,0.35)';
      ctx.lineWidth = 0.55;
      ctx.beginPath();
      ctx.moveTo(x - L, y); ctx.lineTo(x + L, y);
      ctx.moveTo(x, y - L); ctx.lineTo(x, y + L);
      ctx.stroke();
    }
  }

  function drawComet(ctx, x, y, size, vx, vy) {
    const mag = Math.hypot(vx, vy) || 1;
    const tailLen = 30 + size * 4;
    const tx = x - (vx / mag) * tailLen;
    const ty = y - (vy / mag) * tailLen;
    const g = ctx.createLinearGradient(x, y, tx, ty);
    g.addColorStop(0, 'rgba(140,200,255,0.95)');
    g.addColorStop(0.6, 'rgba(140,200,255,0.3)');
    g.addColorStop(1, 'rgba(140,200,255,0)');
    ctx.strokeStyle = g;
    ctx.lineWidth = Math.max(2, size * 1.5);
    ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(tx, ty); ctx.stroke();

    ctx.globalCompositeOperation = 'lighter';
    const sprite = getStarSprite(size * 1.3, 'rgb(160,210,255)');
    ctx.drawImage(sprite.canvas, x - sprite.size/2, y - sprite.size/2);
    ctx.globalCompositeOperation = 'source-over';

    ctx.beginPath();
    ctx.fillStyle = '#dff0ff';
    ctx.arc(x, y, size, 0, Math.PI * 2);
    ctx.fill();
  }

  function drawAsteroid(ctx, x, y, size) {
    ctx.beginPath();
    ctx.fillStyle = 'rgba(255,190,120,0.95)';
    const sides = 7;
    for (let i = 0; i < sides; i++) {
      const a = (i / sides) * Math.PI * 2;
      const r = size * (0.75 + ((i * 53) % 11) / 22);
      const px = x + Math.cos(a) * r;
      const py = y + Math.sin(a) * r;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath(); ctx.fill();
    ctx.globalCompositeOperation = 'lighter';
    const sprite = getStarSprite(size, 'rgb(255,190,120)');
    ctx.drawImage(sprite.canvas, x - sprite.size/2, y - sprite.size/2);
    ctx.globalCompositeOperation = 'source-over';
  }

  function drawFast(ctx, x, y, size) {
    ctx.beginPath();
    ctx.fillStyle = '#ff8a72';
    ctx.arc(x, y, size, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalCompositeOperation = 'lighter';
    const sprite = getStarSprite(size * 1.3, 'rgb(255,120,100)');
    ctx.drawImage(sprite.canvas, x - sprite.size/2, y - sprite.size/2);
    ctx.globalCompositeOperation = 'source-over';
  }

  function drawNebulaMarker(ctx, x, y, size) {
    if (currentBand < 4) return;
    ctx.strokeStyle = 'rgba(255,212,122,0.5)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([3, 4]);
    ctx.beginPath(); ctx.arc(x, y, size * 1.6, 0, Math.PI * 2); ctx.stroke();
    ctx.setLineDash([]);
  }

  function drawLabel(ctx, x, y, text, color, size) {
    const fontSize = size || 12;
    ctx.font = `600 ${fontSize}px ui-monospace, monospace`;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.strokeStyle = 'rgba(0,0,0,0.85)';
    ctx.lineWidth = 3;
    ctx.lineJoin = 'round';
    ctx.strokeText(text, x, y);
    ctx.fillStyle = color;
    ctx.fillText(text, x, y);
  }

  function drawLabels(ctx, t) {
    for (const o of objects) {
      if (!o.name && !o.isDSO) continue;
      const p = posAt(o, t);
      if (p.x < 0 || p.x > W || p.y < 0 || p.y > H) continue;

      if (o.type === 'nebula') {
        if (currentBand < 3) continue;
        drawLabel(ctx, p.x + o.size * 1.6 + 4, p.y, o.name, 'rgba(255,212,122,0.95)', 10);
      } else if (o.isNamed) {
        const spec = SPECTRAL[o.spectral];
        const color = spec ? spec.color : '#ffffff';
        drawLabel(ctx, p.x + o.size + 8, p.y - 2, o.name, color, 12);
      }
    }
  }

  /* -------- Constellation polygon -------- */
  const CONSTELLATION_OUTLINE = ['Betelgeuse', 'Bellatrix', 'Mintaka', 'Rigel', 'Saiph', 'Alnitak', 'Betelgeuse'];
  const CONSTELLATION_BELT = ['Alnitak', 'Alnilam', 'Mintaka'];

  function drawConstellations(ctx, t) {
    // Filled polygon
    const pts = CONSTELLATION_OUTLINE.map(n => {
      const o = objects.find(ob => ob.name === n);
      return o ? posAt(o, t) : null;
    }).filter(Boolean);
    if (pts.length > 2) {
      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
      ctx.closePath();
      ctx.fillStyle = 'rgba(91,157,255,0.04)';
      ctx.fill();
    }
    // Outline
    ctx.strokeStyle = 'rgba(91,157,255,0.3)';
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    for (let i = 0; i < pts.length; i++) {
      if (i === 0) ctx.moveTo(pts[i].x, pts[i].y);
      else ctx.lineTo(pts[i].x, pts[i].y);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    // Belt connections
    ctx.strokeStyle = 'rgba(255,212,122,0.45)';
    ctx.lineWidth = 1.4;
    ctx.setLineDash([2, 3]);
    for (let i = 0; i < CONSTELLATION_BELT.length - 1; i++) {
      const a = objects.find(ob => ob.name === CONSTELLATION_BELT[i]);
      const b = objects.find(ob => ob.name === CONSTELLATION_BELT[i+1]);
      if (!a || !b) continue;
      const pa = posAt(a, t), pb = posAt(b, t);
      ctx.beginPath();
      ctx.moveTo(pa.x, pa.y);
      ctx.lineTo(pb.x, pb.y);
      ctx.stroke();
    }
    ctx.setLineDash([]);

    // Head connection
    const bet = objects.find(o => o.name === 'Betelgeuse');
    const mei = objects.find(o => o.name === 'Meissa');
    const bell = objects.find(o => o.name === 'Bellatrix');
    if (bet && mei && bell) {
      const pb = posAt(bet, t), pm = posAt(mei, t), pbe = posAt(bell, t);
      ctx.strokeStyle = 'rgba(91,157,255,0.22)';
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 4]);
      ctx.beginPath();
      ctx.moveTo(pb.x, pb.y); ctx.lineTo(pm.x, pm.y); ctx.lineTo(pbe.x, pbe.y);
      ctx.stroke();
      ctx.setLineDash([]);
    }
  }

  /* -------- State -------- */
  const state = {
    t: 0, playing: false, blinking: false, blinkPhase: 0,
    showTrails: true, showGhosts: true, showVectors: true, showLabels: true,
    showConstellations: true, showNebula: true,
    speed: 1.0, presenting: false,
    direction: 1, lastTime: 0, rafId: null, blinkTimer: null,
    selectedId: null,
  };

  /* -------- Render -------- */
  function renderLeft() {
    ctxA.clearRect(0, 0, W, H);
    drawBackground(ctxA);
    if (state.showConstellations) drawConstellations(ctxA, 0);
    for (const o of objects) {
      const p = posAt(o, 0);
      drawOneObject(ctxA, o, p.x, p.y, false, false);
    }
    if (state.showLabels) drawLabels(ctxA, 0);
  }

  function renderRight() {
    const displayT = state.blinking ? state.blinkPhase : state.t;
    document.getElementById('tTag').textContent = 't = ' + displayT.toFixed(2);

    ctxB.clearRect(0, 0, W, H);
    drawBackground(ctxB);

    if (state.showTrails) {
      for (const o of objects) {
        if (o.type === 'star' || o.type === 'nebula') continue;
        const p0 = posAt(o, 0);
        const p1 = posAt(o, 1);
        if (Math.hypot(p1.x - p0.x, p1.y - p0.y) < 3) continue;
        const samples = o.perpX !== undefined ? 22 : 2;
        ctxB.beginPath();
        ctxB.strokeStyle = 'rgba(255,94,138,0.3)';
        ctxB.lineWidth = 1.5;
        ctxB.setLineDash([4, 4]);
        for (let s = 0; s <= samples; s++) {
          const tt = s / samples;
          const p = posAt(o, tt);
          if (s === 0) ctxB.moveTo(p.x, p.y); else ctxB.lineTo(p.x, p.y);
        }
        ctxB.stroke();
        ctxB.setLineDash([]);
      }
    }

    if (state.showGhosts) {
      for (const o of objects) {
        if (o.type === 'star' || o.type === 'nebula') continue;
        const p0 = posAt(o, 0);
        const p1 = posAt(o, 1);
        if (Math.hypot(p1.x - p0.x, p1.y - p0.y) < 3) continue;
        ctxB.beginPath();
        ctxB.strokeStyle = 'rgba(127,179,255,0.5)';
        ctxB.lineWidth = 1.2;
        ctxB.arc(p0.x, p0.y, o.size + 3, 0, Math.PI * 2);
        ctxB.stroke();
      }
    }

    if (state.showVectors) {
      for (const o of objects) {
        if (o.type === 'star' || o.type === 'nebula') continue;
        const spd = Math.hypot(o.vx, o.vy);
        if (spd < 60) continue;
        const p = posAt(o, displayT);
        const L = 16 + spd * 0.05;
        const ux = o.vx / spd, uy = o.vy / spd;
        const ex = p.x + ux * L;
        const ey = p.y + uy * L;
        ctxB.beginPath();
        ctxB.strokeStyle = 'rgba(255,94,138,0.7)';
        ctxB.lineWidth = 1.4;
        ctxB.moveTo(p.x, p.y); ctxB.lineTo(ex, ey); ctxB.stroke();
        const px = -uy, py = ux;
        ctxB.beginPath();
        ctxB.fillStyle = 'rgba(255,94,138,0.85)';
        ctxB.moveTo(ex, ey);
        ctxB.lineTo(ex - ux*6 + px*4, ey - uy*6 + py*4);
        ctxB.lineTo(ex - ux*6 - px*4, ey - uy*6 - py*4);
        ctxB.closePath();
        ctxB.fill();
      }
    }

    if (state.showConstellations) drawConstellations(ctxB, displayT);

    for (const o of objects) {
      const p = posAt(o, displayT);
      const highlighted = o.type !== 'star' && o.type !== 'nebula';
      const selected = state.selectedId === o.id;
      drawOneObject(ctxB, o, p.x, p.y, highlighted, selected);
    }

    if (state.showLabels) drawLabels(ctxB, displayT);
  }

  function drawOneObject(ctx, o, x, y, highlighted, selected) {
    const band = BANDS[currentBand];
    const isFeatured = !band.filter || band.filter(o);
    const alpha = isFeatured ? 1.0 : 0.22;

    ctx.globalAlpha = alpha;

    if (o.type === 'star') drawStar(ctx, x, y, o.size, o.spectral);
    else if (o.type === 'comet') drawComet(ctx, x, y, o.size, o.vx, o.vy);
    else if (o.type === 'asteroid') drawAsteroid(ctx, x, y, o.size);
    else if (o.type === 'fast') drawFast(ctx, x, y, o.size);
    else if (o.type === 'nebula') drawNebulaMarker(ctx, x, y, o.size);

    ctx.globalAlpha = 1;

    if (selected) {
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.7;
      ctx.beginPath(); ctx.arc(x, y, o.size + 14, 0, Math.PI * 2); ctx.stroke();
    }
    if (highlighted && o.type !== 'nebula') {
      ctx.strokeStyle = 'rgba(255,94,138,0.85)';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(x, y, o.size + 6, 0, Math.PI * 2); ctx.stroke();
    }
  }

  /* -------- UI -------- */
  const slider = document.getElementById('slider');
  const readout = document.getElementById('readout');
  const playBtn = document.getElementById('playBtn');
  const blinkBtn = document.getElementById('blinkBtn');
  const labelBtn = document.getElementById('labelBtn');
  const trailBtn = document.getElementById('trailBtn');
  const ghostBtn = document.getElementById('ghostBtn');
  const vectorBtn = document.getElementById('vectorBtn');
  const constBtn = document.getElementById('constBtn');
  const nebulaBtn = document.getElementById('nebulaBtn');
  const blinkIndicator = document.getElementById('blinkIndicator');
  const starList = document.getElementById('starList');
  const infoPanel = document.getElementById('infoPanel');
  const insSubtitle = document.getElementById('insSubtitle');
  const bandSelector = document.getElementById('bandSelector');
  const bandBadgeA = document.getElementById('bandBadgeA');
  const bandBadgeB = document.getElementById('bandBadgeB');
  const speedBadgeA = document.getElementById('speedBadgeA');
  const speedBadgeB = document.getElementById('speedBadgeB');
  const speedRange = document.getElementById('speedRange');
  const speedValue = document.getElementById('speedValue');
  const presentBtn = document.getElementById('presentBtn');
  const snapBtn = document.getElementById('snapBtn');
  const presentationExit = document.getElementById('presentationExit');

  const MONTHS = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  function updateReadout() {
    const start = Date.UTC(2025, 0, 1);
    const end = Date.UTC(2025, 6, 2);
    const d = new Date(start + (end - start) * state.t);
    readout.textContent = MONTHS[d.getUTCMonth()] + ' ' + d.getUTCFullYear();
  }

  /* -------- Speed -------- */
  function setSpeed(value) {
    state.speed = Math.max(0.1, Math.min(8.0, value));
    const display = state.speed.toFixed(2) + '×';
    speedValue.textContent = display;
    speedBadgeA.textContent = display;
    speedBadgeB.textContent = display;
    speedRange.value = Math.round(state.speed * 100);
    document.querySelectorAll('.speed-preset').forEach(p => {
      const pv = parseFloat(p.dataset.speed);
      p.classList.toggle('on', Math.abs(pv - state.speed) < 0.001);
    });
  }
  document.querySelectorAll('.speed-preset').forEach(p => {
    p.addEventListener('click', () => setSpeed(parseFloat(p.dataset.speed)));
  });
  speedRange.addEventListener('input', (e) => setSpeed(parseFloat(e.target.value) / 100));

  /* -------- Band selector -------- */
  function buildBandSelector() {
    bandSelector.innerHTML = '';
    BANDS.forEach((b, i) => {
      const chip = document.createElement('div');
      chip.className = 'band-chip' + (i === currentBand ? ' on' : '');
      chip.style.color = i === currentBand ? b.color : '';
      chip.innerHTML = `${b.name}<span class="wl">${b.wl.toFixed(2)} µm</span>`;
      chip.title = b.desc;
      chip.addEventListener('click', () => {
        currentBand = i;
        updateBandUI();
        renderLeft();
        renderRight();
      });
      bandSelector.appendChild(chip);
    });
  }

  function updateBandUI() {
    const b = BANDS[currentBand];
    bandBadgeA.textContent = `${b.name} · ${b.wl.toFixed(2)} µm`;
    bandBadgeB.textContent = `${b.name} · ${b.wl.toFixed(2)} µm`;
    bandBadgeA.style.color = b.color;
    bandBadgeB.style.color = b.color;
    document.querySelectorAll('.band-chip').forEach((c, i) => {
      c.classList.toggle('on', i === currentBand);
      c.style.color = i === currentBand ? BANDS[i].color : '';
    });
  }

  slider.addEventListener('input', () => {
    if (state.playing) stopPlay();
    if (state.blinking) stopBlink();
    state.t = slider.value / 100;
    updateReadout();
    renderRight();
  });

  /* -------- Play -------- */
  function startPlay() {
    if (state.blinking) stopBlink();
    state.playing = true;
    playBtn.classList.add('on');
    playBtn.textContent = '❚❚ Pause';
    state.lastTime = performance.now();
    state.rafId = requestAnimationFrame(playLoop);
  }
  function stopPlay() {
    state.playing = false;
    playBtn.classList.remove('on');
    playBtn.textContent = '▶ Play';
    if (state.rafId) cancelAnimationFrame(state.rafId);
    state.rafId = null;
  }
  function playLoop(now) {
    if (!state.playing) return;
    const dt = Math.min(64, now - state.lastTime);
    state.lastTime = now;
    const baseRate = 0.00028;
    const phase = state.direction > 0 ? state.t : 1 - state.t;
    const ease = 0.5 + Math.abs(Math.cos(phase * Math.PI)) * 1.2;
    state.t += state.direction * baseRate * ease * state.speed * dt;
    if (state.t >= 1) { state.t = 1; state.direction = -1; }
    if (state.t <= 0) { state.t = 0; state.direction = 1; }
    slider.value = state.t * 100;
    updateReadout();
    renderRight();
    state.rafId = requestAnimationFrame(playLoop);
  }
  playBtn.addEventListener('click', () => {
    if (state.playing) stopPlay(); else startPlay();
  });

  /* -------- Blink -------- */
  function startBlink() {
    if (state.playing) stopPlay();
    state.blinking = true;
    blinkBtn.classList.add('on');
    blinkBtn.textContent = '⚡ Stop';
    blinkIndicator.classList.add('on');
    state.blinkPhase = 1;
    blinkIndicator.textContent = 'EPOCH 2 · JUL 2025';
    renderRight();
    const interval = Math.max(150, Math.round(600 / state.speed));
    state.blinkTimer = setInterval(() => {
      state.blinkPhase = 1 - state.blinkPhase;
      blinkIndicator.textContent = state.blinkPhase === 0 ? 'EPOCH 1 · JAN 2025' : 'EPOCH 2 · JUL 2025';
      renderRight();
    }, interval);
  }
  function stopBlink() {
    state.blinking = false;
    blinkBtn.classList.remove('on');
    blinkBtn.textContent = '⚡ Blink';
    blinkIndicator.classList.remove('on');
    if (state.blinkTimer) clearInterval(state.blinkTimer);
    state.blinkTimer = null;
    renderRight();
  }
  blinkBtn.addEventListener('click', () => {
    if (state.blinking) stopBlink(); else startBlink();
  });

  /* -------- Overlays -------- */
  labelBtn.addEventListener('click', () => {
    state.showLabels = !state.showLabels;
    labelBtn.classList.toggle('on', state.showLabels);
    renderLeft(); renderRight();
  });
  trailBtn.addEventListener('click', () => {
    state.showTrails = !state.showTrails;
    trailBtn.classList.toggle('on', state.showTrails);
    renderRight();
  });
  ghostBtn.addEventListener('click', () => {
    state.showGhosts = !state.showGhosts;
    ghostBtn.classList.toggle('on', state.showGhosts);
    renderRight();
  });
  vectorBtn.addEventListener('click', () => {
    state.showVectors = !state.showVectors;
    vectorBtn.classList.toggle('on', state.showVectors);
    renderRight();
  });
  constBtn.addEventListener('click', () => {
    state.showConstellations = !state.showConstellations;
    constBtn.classList.toggle('on', state.showConstellations);
    renderLeft(); renderRight();
  });
  nebulaBtn.addEventListener('click', () => {
    state.showNebula = !state.showNebula;
    nebulaBtn.classList.toggle('on', state.showNebula);
    renderLeft(); renderRight();
  });

  /* -------- Catalog -------- */
  function buildCatalog() {
    starList.innerHTML = '';
    const named = objects.filter(o => o.isNamed || o.isDSO);
    named.sort((a, b) => a.mag - b.mag);

    for (const o of named) {
      const row = document.createElement('div');
      row.className = 'star-row' + (state.selectedId === o.id ? ' selected' : '');
      const color = o.type === 'nebula' ? '#ffd47a'
                  : (SPECTRAL[o.spectral] ? SPECTRAL[o.spectral].color : '#fff');
      const cls = o.type === 'nebula' ? 'DSO' : (o.spectral || '—');
      const bayerStr = o.bayer ? `<span class="bayer">${o.bayer}</span>` : '';
      row.innerHTML = `
        <span class="dot" style="background:${color};color:${color}"></span>
        <span class="nm">${o.name}</span>
        ${bayerStr}
        <span class="cls">${cls}</span>
        <span class="mag">mag ${o.mag.toFixed(2)}</span>
        <span class="dist">${o.dist || ''}</span>
      `;
      row.addEventListener('click', () => selectObject(o));
      starList.appendChild(row);
    }
  }

  function selectObject(o) {
    state.selectedId = o ? o.id : null;
    if (!o) {
      infoPanel.innerHTML = `<div class="info-hint">🔍 Click any object or catalog entry to inspect it</div>`;
      insSubtitle.textContent = '—';
      buildCatalog(); renderLeft(); renderRight();
      return;
    }

    const typeInfo = {
      star: { label: 'Star', color: '#ffffff' },
      comet: { label: 'Comet', color: '#7fb3ff' },
      asteroid: { label: 'Asteroid', color: '#ffb347' },
      fast: { label: 'NEO', color: '#ff7864' },
      nebula: { label: 'Deep-sky object', color: '#ffd47a' },
    };
    const info = typeInfo[o.type] || { label: o.type, color: '#fff' };

    const p0 = posAt(o, 0);
    const p1 = posAt(o, 1);
    const disp = Math.hypot(p1.x - p0.x, p1.y - p0.y);
    const arcminPerPx = (30 * 60) / W;
    const dispArcmin = disp * arcminPerPx;

    let spectralInfo = '';
    if (o.type === 'star' && o.spectral) {
      const sp = SPECTRAL[o.spectral];
      spectralInfo = `<span>spectral <strong>${o.spectral}</strong> · ${sp.temp}</span>`;
    }
    let motionInfo = '';
    if (o.type !== 'star' && o.type !== 'nebula') {
      const velocity = Math.hypot(o.vx, o.vy) * arcminPerPx;
      motionInfo = `<span>Δ <strong>${dispArcmin.toFixed(1)}′</strong></span><span>v <strong>${(velocity / 6).toFixed(2)}′/mo</strong></span>`;
    }

    let spectrumHTML = '<div class="spectrum-bar">';
    BANDS.forEach((b, i) => {
      const active = !b.filter || b.filter(o);
      spectrumHTML += `<div class="band${active ? ' on' : ''}" style="background:${b.color};opacity:${active ? 1 : 0.3}" title="${b.name} · ${b.wl} µm: ${b.desc}">${b.name}</div>`;
    });
    spectrumHTML += '</div>';

    infoPanel.innerHTML = `
      <div class="info-header">
        <span class="info-id">${o.id}</span>
        <span class="info-name">${o.name || info.label}</span>
        ${o.bayer ? `<span class="info-bayer">${o.bayer}</span>` : ''}
      </div>
      <div class="info-fields">
        <span>mag <strong>${o.mag.toFixed(2)}</strong></span>
        ${o.dist ? `<span>dist <strong>${o.dist}</strong></span>` : ''}
        ${spectralInfo}
        ${motionInfo}
      </div>
      <div class="info-desc">${o.desc || `<strong>${info.label}.</strong> A simulated source in this SPHEREx field.`}</div>
      <div style="margin-top:4px">
        <div style="font-size:0.65rem;color:var(--dim);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:4px;">Band visibility</div>
        ${spectrumHTML}
      </div>
    `;
    insSubtitle.textContent = o.name ? o.name : o.id;
    buildCatalog(); renderLeft(); renderRight();
  }

  cvB.addEventListener('click', (e) => {
    const rect = cvB.getBoundingClientRect();
    const mx = (e.clientX - rect.left) * (W / rect.width);
    const my = (e.clientY - rect.top) * (H / rect.height);
    const displayT = state.blinking ? state.blinkPhase : state.t;
    let best = null, bestDist = 20;
    for (const o of objects) {
      const p = posAt(o, displayT);
      const d = Math.hypot(p.x - mx, p.y - my);
      const hitR = Math.max(14, o.size + 6);
      if (d < bestDist && d < hitR) { bestDist = d; best = o; }
    }
    if (best) selectObject(best);
  });

  /* -------- Stats -------- */
  function computeStats() {
    let total = objects.length;
    let moving = 0;
    for (const o of objects) {
      if (o.type === 'star' || o.type === 'nebula') continue;
      const p0 = posAt(o, 0);
      const p1 = posAt(o, 1);
      if (Math.hypot(p1.x - p0.x, p1.y - p0.y) > 3) moving++;
    }
    document.getElementById('statTotal').textContent = total;
    document.getElementById('statMoving').textContent = moving;
    document.getElementById('statNamed').textContent = objects.filter(o => o.isNamed).length;
    document.getElementById('statDSO').textContent = objects.filter(o => o.isDSO).length;
  }

  /* -------- Presentation mode -------- */
  let presentationTimer = null;
  const PRESENT_SEQUENCE = [
    { band: 0, t: 0, speed: 1.0, features: { labels: true, trails: false, ghosts: false, vectors: false, constellations: true, nebula: true }, wait: 4000 },
    { band: 2, t: 0.3, speed: 1.0, features: { labels: true, trails: true, ghosts: true, vectors: true, constellations: true, nebula: true }, wait: 5000 },
    { band: 5, t: 0.7, speed: 1.0, features: { labels: true, trails: true, ghosts: true, vectors: true, constellations: false, nebula: true }, wait: 4000 },
    { band: 9, t: 1.0, speed: 1.0, features: { labels: true, trails: true, ghosts: true, vectors: true, constellations: false, nebula: true }, wait: 4000 },
  ];
  let presentStep = 0;

  function startPresentation() {
    state.presenting = true;
    document.body.classList.add('presenting');
    presentStep = 0;
    runPresentStep();
  }

  function runPresentStep() {
    if (!state.presenting) return;
    if (presentStep >= PRESENT_SEQUENCE.length) {
      endPresentation();
      return;
    }
    const step = PRESENT_SEQUENCE[presentStep];
    currentBand = step.band;
    state.t = step.t;
    slider.value = state.t * 100;
    updateBandUI();
    updateReadout();
    // Feature flags
    state.showLabels = step.features.labels;
    state.showTrails = step.features.trails;
    state.showGhosts = step.features.ghosts;
    state.showVectors = step.features.vectors;
    state.showConstellations = step.features.constellations;
    state.showNebula = step.features.nebula;
    labelBtn.classList.toggle('on', state.showLabels);
    trailBtn.classList.toggle('on', state.showTrails);
    ghostBtn.classList.toggle('on', state.showGhosts);
    vectorBtn.classList.toggle('on', state.showVectors);
    constBtn.classList.toggle('on', state.showConstellations);
    nebulaBtn.classList.toggle('on', state.showNebula);
    setSpeed(step.speed);
    renderLeft(); renderRight();
    // Auto-play the timeline between steps
    if (!state.playing) startPlay();
    presentStep++;
    presentationTimer = setTimeout(runPresentStep, step.wait);
  }

  function endPresentation() {
    state.presenting = false;
    document.body.classList.remove('presenting');
    if (presentationTimer) clearTimeout(presentationTimer);
    presentationTimer = null;
  }

  presentBtn.addEventListener('click', () => {
    if (state.presenting) endPresentation();
    else startPresentation();
  });
  presentationExit.addEventListener('click', endPresentation);

  /* -------- Snapshot -------- */
  snapBtn.addEventListener('click', () => {
    const link = document.createElement('a');
    link.download = 'spherex-snapshot-' + Date.now() + '.png';
    link.href = cvB.toDataURL('image/png');
    link.click();
  });

  /* -------- Keyboard -------- */
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT') return;
    const k = e.key.toLowerCase();
    if (k === ' ') { e.preventDefault(); playBtn.click(); }
    else if (k === 'b') blinkBtn.click();
    else if (k === 't') trailBtn.click();
    else if (k === 'g') ghostBtn.click();
    else if (k === 'v') vectorBtn.click();
    else if (k === 'l') labelBtn.click();
    else if (k === 'c') constBtn.click();
    else if (k === 'p') presentBtn.click();
    else if (k === 's') snapBtn.click();
    else if (k === 'escape') {
      selectObject(null);
      if (state.presenting) endPresentation();
    }
    else if (k === '[') setSpeed(Math.max(0.1, state.speed - 0.1));
    else if (k === ']') setSpeed(Math.min(8.0, state.speed + 0.1));
    else if (k === 'r') setSpeed(1.0);
    else if (k >= '1' && k <= '9') {
      const i = parseInt(k) - 1;
      if (i < BANDS.length) { currentBand = i; updateBandUI(); renderLeft(); renderRight(); }
    }
    else if (k === '0') { currentBand = 9; updateBandUI(); renderLeft(); renderRight(); }
    else if (k === 'arrowleft') {
      slider.value = Math.max(0, parseFloat(slider.value) - 2);
      slider.dispatchEvent(new Event('input'));
      e.preventDefault();
    }
    else if (k === 'arrowright') {
      slider.value = Math.min(100, parseFloat(slider.value) + 2);
      slider.dispatchEvent(new Event('input'));
      e.preventDefault();
    }
  });

  /* -------- Intro fade -------- */
  setTimeout(() => {
    const intro = document.getElementById('intro');
    if (intro) intro.classList.add('fade');
    setTimeout(() => { if (intro) intro.remove(); }, 1100);
  }, 2600);

  /* -------- Init -------- */
  buildBandSelector();
  updateBandUI();
  setSpeed(1.0);
  updateReadout();
  computeStats();
  buildCatalog();
  renderLeft();
  renderRight();

  setTimeout(() => { if (!state.playing) startPlay(); }, 3400);

})();
</script>
</body>
</html>
